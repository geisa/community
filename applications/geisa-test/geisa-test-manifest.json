{
  "geisa-application-manifest": {
    "manifest": {
      "app-id": "com.pragsol.geisa-test",
      "author": "PragSol Consulting LLC",
      "name": "geisa-test",
      "description": "GEISA 0.9.0 application for API and LEE resource-test workloads.",
      "app-version": "0.8.11",
      "manifest-version": "0.9.0",
      "artifacts": [
        {
          "image-name": "__IMAGE_NAME__",
          "image-type": "appoverlay",
          "image-size": "__IMAGE_SIZE__",
          "uncompressed-size": "__UNCOMPRESSED_SIZE__",
          "signature": {
            "signatureType": "ECDSA",
            "signatureLength": "__ARTIFACT_SIGNATURE_LENGTH__",
            "signatureHex": "__ARTIFACT_SIGNATURE_HEX__",
            "signatureReference": "__ARTIFACT_SIGNATURE_REFERENCE__"
          }
        }
      ],
      "api-access": {
        "messaging": true,
        "actuator-status": false,
        "actuator-control": false,
        "instantaneous": false,
        "sensor": false,
        "waveform": false
      },
      "compatibility": {
        "GEISA-API": "0.9.0",
        "GEISA-LEE": "0.9.0",
        "GEISA-VEE": null,
        "toolchain-id": "__TOOLCHAIN_ID__",
        "toolchain-version": "__TOOLCHAIN_VERSION__"
      },
      "default-configuration": {
        "reporting_enabled": true,
        "reporting_interval_seconds": 3600,
        "reporting_message_types": [
          "EVENT",
          "ALARM",
          "APP_DATA",
          "TELEMETRY"
        ],
        "payload_size_bytes": 256,
        "payload_pattern": "alpha",
        "message_count": 0,
        "expected_status": "GEISA_APP_MESSAGE_STATUS_ACCEPTED",
        "mode": "normal",
        "test_duration_ms": 1000,
        "test_target_bytes": 1048576,
        "test_chunk_bytes": 65536,
        "cpu_intensity_percent": 100,
        "burst_count": 4,
        "burst_interval_ms": 1000,
        "quota_interval_ms": 1000,
        "quota_max_attempts": 10
      },
      "default-launch-strategy": {
        "auto-restart": true,
        "max-restarts": 5,
        "restart-period": 60,
        "start-timeout": 15,
        "start-background": true,
        "start-string": "./geisa-test",
        "stop-string": "pkill -TERM -x geisa-test",
        "stop-timeout": 15,
        "notify-timeout": 30,
        "watchdog": false
      },
      "external-dependencies": [],
      "communication": {
        "messaging": {
          "daily-messages": 128
        }
      },
      "resources": {
        "app-cpu": 10,
        "app-ram": 65536,
        "storage-persistent": 16384,
        "storage-nonpersistent": 16384
      }
    },
    "signature": {
      "signatureType": "ECDSA",
      "signatureLength": "__MANIFEST_SIGNATURE_LENGTH__",
      "signatureHex": "__MANIFEST_SIGNATURE_HEX__",
      "signatureReference": "__MANIFEST_SIGNATURE_REFERENCE__"
    }
  }
}
