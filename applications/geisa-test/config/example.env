# Optional local/developer settings for bounded storage-resource tests.
# Normal GEISA LEE broker configuration is read from /etc/geisa/mqtt.conf;
# these roots are not a substitute for the platform-provided MQTT config.
GEISA_TEST_PERSISTENT_STORAGE_DIR=/path/provided/by/test-lee/persistent
GEISA_TEST_TRANSIENT_STORAGE_DIR=/path/provided/by/test-lee/transient
