#
# Keep the FRDM-i.MX93 primary Ethernet identity stable for DHCP reservations
# without baking a globally duplicated MAC address into the publishable image.

[Match]
OriginalName=end0

[Link]
Name=end0
MACAddressPolicy=persistent
